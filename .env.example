# ── Application ──
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql://crm:crm_secret@postgres:5432/crm_db

# ── First superuser (created on startup) ──
FIRST_SUPERUSER_EMAIL=admin@admin.com
FIRST_SUPERUSER_PASSWORD=admin

# ── PostgreSQL ──
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm_secret
POSTGRES_DB=crm_db

# ── Google Sheets sync ──
# Path to service account JSON file, or raw JSON string
GOOGLE_CREDENTIALS_JSON=
# Google Spreadsheet ID (from the URL)
SPREADSHEET_ID=
# Import from Sheets is disabled by default in V2 (Postgres primary)
GOOGLE_SHEETS_IMPORT_ENABLED=false

# ── Firebase push (optional) ──
# Path to Firebase service account JSON file, or raw JSON string
FIREBASE_CREDENTIALS_JSON=

# ── Schema ──
SCHEMA_PATH=/app/schema.json
